<launch>
    <arg name="sim" default="false"/>
    <param name="/use_sim_time" value="$(arg sim)"/>

    <!-- This is to differenciare raw/compressed input -->
    <arg name="is_compressed" default="true"/>

    <!-- This is to indicate if the image is rectified or not -->
    <arg name="is_rectified" default="false"/>
    
    <!-- Input image from the robot (no /compressed at the end, reoublish will handle it) -->
    <arg name="original_image" default="/girona500/front_camera/camera/image_raw"/>
    
    <!-- Decompressed image (compressed -> RAW; RAW -> RAW) we keep the original name, to know if it is rectified or not-->
    <arg name="clean_image_topic" value="$(arg original_image)/decompressed"/>
    
    <!-- CameraInfo topic -->
    <arg name="camera_info_topic" default="/girona500/bravo/gripper/camera/camera_info"/>

    <!-- Output topic with yolo bboxes detecions -->
    <arg name="yolo_output_topic" default="/net_hole_detector/detections"/>

    <!-- If the original image is compressed we decompress it -->
    <group if="$(arg is_compressed)">
        <node pkg="image_transport" type="republish" name="descomprimidor" output="screen" 
              args="compressed in:=$(arg original_image) raw out:=$(arg clean_image_topic)" />
    </group>

    <!-- If the original image is not compressed we republish it as it is -->
    <group unless="$(arg is_compressed)">
        <node pkg="topic_tools" type="relay" name="img_relay" 
              args="$(arg original_image) $(arg clean_image_topic)"/>
    </group>

    <!-- Yolo detector node -->
    <include file="$(find net_hole_detector)/launch/yolo_inference.launch">
        <arg name="input_image_topic" value="$(arg clean_image_topic)"/>
        <arg name="output_topic"      value="$(arg yolo_output_topic)"/>
    </include>

    <!-- 3D Position node -->
    <include file="$(find net_hole_detector)/launch/detector_3d.launch">
        <arg name="image_topic"       value="$(arg clean_image_topic)"/>
        <arg name="camera_info_topic" value="$(arg camera_info_topic)"/>
        <arg name="yolo_input_topic"  value="$(arg yolo_output_topic)"/>
        <arg name="is_rectified"      value="$(arg is_rectified)"/>
    </include>

</launch>