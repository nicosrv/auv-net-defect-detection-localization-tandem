<launch>
        <!--
        Runs a second stereo_image_proc instance using the masked stereo images
        generated after FastSAM segmentation. This restricts disparity estimation
        to the region around the detected hole, while the wider disparity range
        allows closer objects to be reconstructed more reliably.
    -->
    <!-- Second stereo_image_proc, applied on the masked stereo images generated with FastSAM -->
    <node pkg="stereo_image_proc"
          type="stereo_image_proc"
          name="stereo_image_proc"
          ns="masked_stereo"
          output="screen">

        <param name="approximate_sync" value="true"/>
        <param name="queue_size" value="10"/>

        <!-- Allows large disparities for close-range reconstruction -->
        <param name="min_disparity" value="0"/>
        <param name="disparity_range" value="256"/>

        <!-- Permissive stereo-matching parameters for masked underwater images -->
        <param name="correlation_window_size" value="15"/>
        <param name="texture_threshold" value="0"/>
        <param name="uniqueness_ratio" value="5"/>
        <param name="speckle_size" value="50"/>
        <param name="speckle_range" value="2"/>

        <remap from="left/image_raw" to="/masked_stereo/left/image_raw"/>
        <remap from="left/camera_info" to="/masked_stereo/left/camera_info"/>

        <remap from="right/image_raw" to="/masked_stereo/right/image_raw"/>
        <remap from="right/camera_info" to="/masked_stereo/right/camera_info"/>
    </node>
</launch>
